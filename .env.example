# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Preferred Google Drive PDF uploads for admin cookbook files.
# Use OAuth so uploads consume your own Google Drive storage quota.
GOOGLE_OAUTH_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_OAUTH_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
GOOGLE_DRIVE_REFRESH_TOKEN="YOUR_GOOGLE_DRIVE_REFRESH_TOKEN"
GOOGLE_DRIVE_FOLDER_ID="YOUR_DRIVE_FOLDER_ID"
GOOGLE_DRIVE_PUBLIC_READ="true"

# Optional fallback for Google Workspace Shared Drives only.
# Service accounts do not have personal My Drive storage quota.
GOOGLE_SERVICE_ACCOUNT_EMAIL="service-account-name@project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
