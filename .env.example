# ───────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill in your own values.
#  Only variables prefixed with NEXT_PUBLIC_ are exposed to the
#  browser. NEVER put secrets (KEY_SECRET / service role key)
#  in a NEXT_PUBLIC_ variable.
# ───────────────────────────────────────────────────────────

# Supabase — REQUIRED. Project URL + anon (public) key.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# Server-only service role key. Used to verify admin identity and to
# record purchases server-side. Optional but strongly recommended.
# Find it: Supabase dashboard → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=""

# Razorpay — REQUIRED for checkout.
# Test keys: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"

# Google Drive PDF delivery for admin cookbook uploads (optional).
# Prefer OAuth so uploads consume your own Drive storage quota.
GOOGLE_OAUTH_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_OAUTH_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
GOOGLE_DRIVE_REFRESH_TOKEN="YOUR_GOOGLE_DRIVE_REFRESH_TOKEN"
GOOGLE_DRIVE_FOLDER_ID="YOUR_DRIVE_FOLDER_ID"
GOOGLE_DRIVE_PUBLIC_READ="true"

# Optional fallback for Google Workspace Shared Drives ONLY.
# Service accounts have no personal My Drive storage quota.
GOOGLE_SERVICE_ACCOUNT_EMAIL="service-account@project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE_KEY-----\n"
GOOGLE_ALLOW_SERVICE_ACCOUNT_UPLOAD="false"
